{
  "name": "museumai-frontend",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint app components lib types scripts prisma.config.ts eslint.config.mjs prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test:ai": "tsx --test lib/ai/*.test.ts",
    "test:flow": "tsx scripts/test-ai-flow.ts",
    "test:narration": "tsx scripts/test-narration-flow.ts",
    "test:review": "tsx scripts/test-review-flow.ts",
    "test:publish": "tsx scripts/test-publish-flow.ts",
    "test:demo": "tsx scripts/test-demo-flow.ts",
    "test:stability": "tsx --test lib/client-errors.test.ts && tsx scripts/test-stability.ts",
    "test:mvp": "tsx scripts/test-mvp-final.ts",
    "format": "prettier --write \"{app,components,lib,types,prisma,scripts}/**/*.{ts,tsx,css}\" *.json *.js *.mjs *.ts",
    "format:check": "prettier --check \"{app,components,lib,types,prisma,scripts}/**/*.{ts,tsx,css}\" *.json *.js *.mjs *.ts",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@types/node": "20.17.10",
    "@types/react": "19.0.2",
    "autoprefixer": "10.4.20",
    "dotenv": "16.6.1",
    "next": "15.5.26",
    "postcss": "8.4.49",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.26",
    "prettier": "3.6.2",
    "prisma": "^6.19.0",
    "tsx": "4.20.6"
  }
}
