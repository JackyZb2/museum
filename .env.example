DATABASE_URL=sqlite:///./museumai.db
NEXT_PUBLIC_API_URL=http://localhost:8000
UPLOAD_DIR=uploads

# Prisma core database; path is relative to frontend/prisma/schema.prisma.
PRISMA_DATABASE_URL=file:./museumai-core.db
# 可选：前端图片目录，留空时使用 frontend/.local-uploads；测试使用独立目录。
MUSEUMAI_UPLOAD_DIRECTORY=

# AI Provider 服务端配置。演示模式使用模拟结果，无需密钥。
DEMO_MODE=true
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_VISION_MODEL=gpt-4.1-mini

# Optional PostgreSQL deployment value:
# DATABASE_URL=postgresql://museumai:museumai@localhost:5432/museumai
